<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GLAZOV.M.CONVERTER.Formats</RootNamespace>
    <Description>Расширение GLAZOV.M.CONVERTER: стандартные форматы (звук, изображения, видео, документы, текст) — значения FileFormat и определение типа по начальным байтам. Движков нет: конвертируют пакеты Ffmpeg, Office, Svg и Pdf.</Description>
    <Version>0.1.0</Version>
    <Authors>Glaz-almaz-GL</Authors>
    <Copyright>Copyright 2026 Glaz-almaz-GL</Copyright>
    <PackageTags>convert;converter;file-format;format-detection;mime</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Glaz-almaz-GL/GLAZOV.M.CONVERTER</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Glaz-almaz-GL/GLAZOV.M.CONVERTER</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GLAZOV.M.CONVERTER.Formats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GLAZOV.M.CONVERTER\GLAZOV.M.CONVERTER.csproj" />
  </ItemGroup>

</Project>
