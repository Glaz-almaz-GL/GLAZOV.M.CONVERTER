<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GLAZOV.M.CONVERTER</RootNamespace>
    <Description>Библиотека конвертации файлов между форматами: файлы, папки и потоки. Тип входа подтверждается по начальным байтам. Первая версия — звук MP3, WAV, OGG (через FFmpeg, установленный отдельно).</Description>
    <Version>0.1.0</Version>
    <Authors>Glaz-almaz-GL</Authors>
    <Copyright>Copyright 2026 Glaz-almaz-GL</Copyright>
    <PackageTags>convert;converter;audio;mp3;wav;ogg;ffmpeg;stream</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Glaz-almaz-GL/GLAZOV.M.CONVERTER</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Glaz-almaz-GL/GLAZOV.M.CONVERTER</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GLAZOV.M.CONVERTER.Tests" />
  </ItemGroup>

</Project>
